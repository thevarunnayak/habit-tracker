generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HabitType {
  CHECK
  PROGRESS
  TIMER
  RATING
  TEXT
  MEASUREMENT
}

enum HabitEntryStatus {
  COMPLETED
  SKIPPED
}

enum StreakStage {
  BEGINNER
  SEMI_PRO
  LEGEND
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  password      String?
  emailVerified DateTime?

  accounts      Account[]
  sessions      Session[]

  // ✅ Habit relations
  habitSets     HabitSet[]
  habits        Habit[]
  habitEntries  HabitEntry[]

  // ✅ Journal relations
  journals      Journal[]

  // ✅ Settings
  defaultStreakStage StreakStage @default(SEMI_PRO)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([email])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailOTP {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model SignupIntent {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// ✅ Habit Set
model HabitSet {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?
  isPinned  Boolean  @default(false)

  // ✅ schedule / occurrence
  isArchived Boolean @default(false)

  /// Bitmask Mon-Sun:
  /// Mon=1 Tue=2 Wed=4 Thu=8 Fri=16 Sat=32 Sun=64
  /// 127 => everyday
  activeDays Int     @default(127)

  // ✅ cached streak analytics
  currentStreak  Int      @default(0)
  bestStreak     Int      @default(0)
  lastStreakDate DateTime?
  streakBrokenAt DateTime?

  // ✅ streak rules for this habit set
  streakStage StreakStage @default(SEMI_PRO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits Habit[]

  @@index([userId])
  @@index([userId, isPinned])
  @@index([userId, isArchived])
  @@index([userId, streakStage])
}

model Habit {
  id         String   @id @default(cuid())
  userId     String
  habitSetId String

  name       String
  type       HabitType @default(CHECK)

  // shared optional config fields
  unit       String?
  isActive   Boolean   @default(true)

  // PROGRESS
  targetInt  Int?

  // TIMER
  targetSec  Int?

  // RATING
  ratingMax  Int?

  // MEASUREMENT
  precision  Int?
  minFloat   Float?
  maxFloat   Float?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitSet HabitSet @relation(fields: [habitSetId], references: [id], onDelete: Cascade)

  entries  HabitEntry[]

  @@index([userId])
  @@index([habitSetId])
  @@index([userId, habitSetId])
  @@index([userId, isActive])
}

model HabitEntry {
  id        String           @id @default(cuid())
  userId    String
  habitId   String

  // normalized start of day (IST normalized by your helper)
  date      DateTime

  status    HabitEntryStatus @default(COMPLETED)

  // CHECK
  checked   Boolean?

  // PROGRESS
  valueInt  Int?

  // TIMER
  durationSec   Int?
  runningSince  DateTime?

  // RATING
  rating    Int?

  // TEXT
  textValue String?

  // MEASUREMENT
  valueFloat Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
  @@index([habitId])
  @@index([habitId, date, status])
}

// 📝 JOURNAL (NEW)
// 📝 JOURNAL
model Journal {
  id        String   @id @default(cuid())
  userId    String

  // Title derived from first line of content
  title     String

  // Day bucket (IST normalized, optional but useful)
  date      DateTime

  // Rich text content (Tiptap JSON)
  content   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, createdAt])
}

