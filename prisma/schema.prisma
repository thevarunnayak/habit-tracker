generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HabitType {
  CHECK
  PROGRESS
  TIMER
  RATING
  TEXT
  MEASUREMENT
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  password      String?
  emailVerified DateTime?

  accounts      Account[]
  sessions      Session[]

  // ✅ Habit relations
  habitSets     HabitSet[]
  habits        Habit[]
  habitEntries  HabitEntry[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailOTP {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model SignupIntent {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// ✅ Habit Set
model HabitSet {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?
  isPinned  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits Habit[]

  @@index([userId])
}

// ✅ Habit
model Habit {
  id         String   @id @default(cuid())
  userId     String
  habitSetId String

  name       String
  type       HabitType @default(CHECK)

  // shared optional config fields
  unit       String?
  isActive   Boolean   @default(true)

  // PROGRESS (target-based counter)
  targetInt  Int?

  // TIMER
  targetSec  Int?

  // RATING
  ratingMax  Int? // ex: 5

  // MEASUREMENT
  precision  Int? // ex: 0 steps, 1 weight, 2 decimals
  minFloat   Float?
  maxFloat   Float?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitSet HabitSet @relation(fields: [habitSetId], references: [id], onDelete: Cascade)
  entries  HabitEntry[]

  @@index([userId])
  @@index([habitSetId])
}

// ✅ Daily entry (1 per habit per day)
model HabitEntry {
  id        String   @id @default(cuid())
  userId    String
  habitId   String

  // normalized "start of day"
  date      DateTime

  // CHECK
  checked   Boolean  @default(false)

  // PROGRESS
  valueInt  Int?

  // TIMER
  durationSec Int?

  // RATING
  rating    Int?

  // TEXT
  textValue String?

  // MEASUREMENT
  valueFloat Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([habitId])
  @@unique([habitId, date])
}
